# Copy to .env on the Mac Mini. Never commit .env.

# Required. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

TZ=Europe/London
WEATHER_LOC=Bristol

# Where the dashboard is reachable. Used to build .ics subscription links.
PUBLIC_URL=http://192.168.10.6

# Home Assistant. Create a long-lived token in HA:
#   click your user (bottom left) -> Security -> Long-lived access tokens
# Leave HA_TOKEN blank to disable all music/device features.
HA_URL=http://host.docker.internal:8123
HA_TOKEN=

# Optional — outbound calendar invites. Blank disables the invite button.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
INVITE_FROM=

# J.A.R.V.I.S. — "Alexa, ask Jarvis ...". See README → J.A.R.V.I.S.
# Claude API key from https://platform.claude.com. Blank disables Jarvis.
ANTHROPIC_API_KEY=
# Skill ID from the Alexa developer console (amzn1.ask.skill....).
ALEXA_SKILL_ID=
# Optional: JARVIS_MODEL (default claude-opus-5-5), JARVIS_EFFORT (default low),
# JARVIS_VOICE (default Brian; set it blank for Alexa's own voice).
# Cloudflare Tunnel that lets Alexa reach the skill endpoint.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=
