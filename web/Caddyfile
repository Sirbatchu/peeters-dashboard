{
	# The Android tablet will only install the dashboard as an app over
	# HTTPS. This box is LAN-only, so Caddy signs its own certificate from a
	# local CA (kept in the caddy_data volume so it survives rebuilds).
	# Plain http:// on :80 stays exactly as it was — the iPad keeps using it,
	# so there is NO http->https redirect.
	auto_https disable_redirects
	skip_install_trust
	# Chrome sends no SNI when you browse to a bare IP, so tell Caddy which
	# certificate to present.
	default_sni 192.168.10.6
}
# Published on the Mini as https://192.168.10.6:8443 (compose maps 8443->443).
# The host matcher ignores the port, so the site address stays as below.

(site) {
	# API and calendar feed proxy to the api container.
	#
	# Exception: Alexa's emulated Hue bridge ("Alexa, bedtime"). It runs in
	# Home Assistant on 192.168.10.6:8300, but Echos only discover a Hue bridge
	# on port 80 — so HA advertises port 80 and these paths are forwarded to
	# it. HA's bridge always hands out the username "nouser" (hue_api.py), so
	# /api/nouser* can never collide with the dashboard's own /api routes.
	# `route` keeps the order literal: Hue first, everything else to the API.
	handle /api/* {
		route {
			reverse_proxy /api/nouser* 192.168.10.6:8300
			reverse_proxy api:3000
		}
	}
	# Hue pairing (POST /api) and discovery document.
	handle /api {
		reverse_proxy 192.168.10.6:8300
	}
	handle /description.xml {
		reverse_proxy 192.168.10.6:8300
	}

	# Hashed build assets: filename changes whenever content changes,
	# so they can be cached hard and forever.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Local CA root, for installing on the tablet once so it trusts the
	# HTTPS certificate (Settings -> Security -> Install a certificate -> CA).
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=peeters-ca.crt"
		file_server
	}

	# SPA. index.html must NEVER be cached — it is the pointer to the
	# current hashed bundle. iOS caching it is what leaves the iPad
	# running an old build after a deploy.
	handle {
		root * /srv
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Pragma "no-cache"
		header Expires "0"
		try_files {path} /index.html
		file_server
	}

	encode gzip
}

:80 {
	import site
}

https://192.168.10.6 {
	tls internal
	import site
}
